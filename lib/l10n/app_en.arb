{
  "@@locale": "en",
  "appTitle": "ToddlerLogic",
  "@appTitle": {
    "description": "Brand name of the app, shown in the main menu and in the recent-apps list. DO NOT TRANSLATE: it must be identical in every language."
  },
  "menuTagline": "Logic and attention games",
  "@menuTagline": {
    "description": "Main menu, under the app name. Read by parents. Short subtitle, max ~35 characters."
  },
  "menuParentsZone": "Parents' Zone",
  "@menuParentsZone": {
    "description": "Small text button at the bottom of the main menu that leads to the adults-only settings. Read by parents. Max ~20 characters."
  },
  "menuParentsZoneComingSoon": "🔒 Parents' Zone (coming soon)",
  "@menuParentsZoneComingSoon": {
    "description": "Brief notice shown when tapping 'Parents' Zone' while it is not available yet. Keep the lock emoji at the start."
  },
  "menuExit": "Exit",
  "@menuExit": {
    "description": "Small text button next to 'Parents' Zone' that closes the app right away, without confirmation (HU-001 R21). Max ~12 characters."
  },
  "menuBadgeSemantics": "Golden badge earned",
  "@menuBadgeSemantics": {
    "description": "Screen reader label for the medal shown next to the Memory button once every level has been beaten."
  },
  "memoryGameTitle": "Memory Game",
  "@memoryGameTitle": {
    "description": "Title at the top of the memory game screen. Max ~20 characters."
  },
  "memoryGameInstructions": "Tap the cards and find the pairs",
  "@memoryGameInstructions": {
    "description": "Instruction under the game title. Read aloud by parents to a 3-year-old: very simple words. May wrap to two lines."
  },
  "memoryGameMovesCounter": "Moves: {count}",
  "@memoryGameMovesCounter": {
    "description": "Small badge in the game header with the number of attempts. Very short, max ~12 characters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "memoryGameHintPlaying": "Let's find the matching pair.",
  "@memoryGameHintPlaying": {
    "description": "Encouraging message at the bottom of the game while the child plays. Warm and positive tone."
  },
  "memoryGameHintProcessing": "Look closely... the card is turning.",
  "@memoryGameHintProcessing": {
    "description": "Message at the bottom while two different cards are shown before turning back. Calm tone, never negative."
  },
  "memoryCardOpenSemantics": "Open card showing {symbol}",
  "@memoryCardOpenSemantics": {
    "description": "Screen-reader label (not visible) for a face-up card. {symbol} is an emoji such as 🐶.",
    "placeholders": {
      "symbol": {
        "type": "String",
        "example": "🐶"
      }
    }
  },
  "memoryCardClosedSemantics": "Closed card",
  "@memoryCardClosedSemantics": {
    "description": "Screen-reader label (not visible) for a face-down card."
  },
  "victoryTitle": "You did it!",
  "@victoryTitle": {
    "description": "Big title of the celebration dialog after winning. Children see it; joyful, max ~20 characters."
  },
  "victoryMessage": "You found all the pairs.",
  "@victoryMessage": {
    "description": "Line under the celebration title."
  },
  "menuMemoryTitle": "Memory",
  "@menuMemoryTitle": {
    "description": "Main menu button that opens the memory game. Children see it; one short word if possible, max ~20 characters."
  },
  "menuMemorySubtitle": "Find the pairs",
  "@menuMemorySubtitle": {
    "description": "Small text under the memory game button. Max ~30 characters."
  },
  "memoryLevelIndicator": "Level {level} of {total}",
  "@memoryLevelIndicator": {
    "description": "Screen-reader label (not visible) of the five dots that show the level reached in the memory game.",
    "placeholders": {
      "level": {
        "type": "int",
        "example": "2"
      },
      "total": {
        "type": "int",
        "example": "5"
      }
    }
  },
  "memoryTimeBarSemantics": "Time left",
  "@memoryTimeBarSemantics": {
    "description": "Screen-reader label (not visible) of the bar that empties as time passes. It never shows numbers."
  },
  "memoryStarsSemantics": "{stars} of {total} stars",
  "@memoryStarsSemantics": {
    "description": "Screen-reader label (not visible) of the stars shown when a board is won.",
    "placeholders": {
      "stars": {
        "type": "int",
        "example": "2"
      },
      "total": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "memoryBadgeTitle": "Golden badge!",
  "@memoryBadgeTitle": {
    "description": "Big title of the special golden celebration when the last level (4x4) is completed. Joyful, max ~25 characters."
  },
  "memoryBadgeMessage": "You completed every level.",
  "@memoryBadgeMessage": {
    "description": "Line under the golden celebration title."
  },
  "memoryTimeUpFewerCards": "Time's up! Let's try with fewer cards",
  "@memoryTimeUpFewerCards": {
    "description": "Calm message when time runs out and the next board has fewer cards. Never negative: it is presented as help."
  },
  "memoryTimeUpRestart": "Time's up! Let's start again, no rush",
  "@memoryTimeUpRestart": {
    "description": "Calm message when time runs out on the smallest board and the game starts again without time. Never negative."
  },
  "exitRepeatHint": "Repeat the gesture to exit",
  "@exitRepeatHint": {
    "description": "Small notice, without buttons, shown after the first Back gesture: the gesture must be repeated to leave. Read by parents."
  }
}
