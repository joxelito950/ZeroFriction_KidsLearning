{
  "@@locale": "en",

  "appTitle": "ToddlerLogic",
  "@appTitle": {
    "description": "Brand name of the app, shown in the main menu and in the recent-apps list. DO NOT TRANSLATE: it must be identical in every language."
  },

  "menuTagline": "Logic and attention games",
  "@menuTagline": {
    "description": "Main menu, under the app name. Read by parents. Short subtitle, max ~35 characters."
  },
  "menuFarmLevelTitle": "Farm Animals",
  "@menuFarmLevelTitle": {
    "description": "Main menu button that opens the easy memory game with farm animals. Children see it; keep it short and friendly, max ~25 characters."
  },
  "menuFarmLevelSubtitle": "Starter level (2x2)",
  "@menuFarmLevelSubtitle": {
    "description": "Small text under 'Farm Animals'. '2x2' is the board size (2 rows by 2 columns); keep it as digits. Max ~25 characters."
  },
  "menuJungleLevelTitle": "Jungle Surprise",
  "@menuJungleLevelTitle": {
    "description": "Main menu button that opens the medium memory game with wild animals. Children see it; playful tone, max ~25 characters."
  },
  "menuJungleLevelSubtitle": "Explorer level (2x3)",
  "@menuJungleLevelSubtitle": {
    "description": "Small text under 'Jungle Surprise'. '2x3' is the board size; keep it as digits. Max ~25 characters."
  },
  "menuParentsZone": "Parents' Zone",
  "@menuParentsZone": {
    "description": "Small text button at the bottom of the main menu that leads to the adults-only settings. Read by parents. Max ~20 characters."
  },
  "menuParentsZoneComingSoon": "🔒 Parents' Zone (coming soon)",
  "@menuParentsZoneComingSoon": {
    "description": "Brief notice shown when tapping 'Parents' Zone' while it is not available yet. Keep the lock emoji at the start."
  },

  "memoryGameTitle": "Memory Game",
  "@memoryGameTitle": {
    "description": "Title at the top of the memory game screen. Max ~20 characters."
  },
  "memoryGameInstructions": "Tap the cards and find the pairs",
  "@memoryGameInstructions": {
    "description": "Instruction under the game title. Read aloud by parents to a 3-year-old: very simple words. May wrap to two lines."
  },
  "memoryGameMovesCounter": "Moves: {count}",
  "@memoryGameMovesCounter": {
    "description": "Small badge in the game header with the number of attempts. Very short, max ~12 characters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "memoryGameHintPlaying": "Let's find the matching pair.",
  "@memoryGameHintPlaying": {
    "description": "Encouraging message at the bottom of the game while the child plays. Warm and positive tone."
  },
  "memoryGameHintProcessing": "Look closely... the card is turning.",
  "@memoryGameHintProcessing": {
    "description": "Message at the bottom while two different cards are shown before turning back. Calm tone, never negative."
  },
  "memoryGameHintCompleted": "Great job! You found all the pairs.",
  "@memoryGameHintCompleted": {
    "description": "Message at the bottom when the game is won. Celebratory tone."
  },

  "memoryCardOpenSemantics": "Open card showing {symbol}",
  "@memoryCardOpenSemantics": {
    "description": "Screen-reader label (not visible) for a face-up card. {symbol} is an emoji such as 🐶.",
    "placeholders": {
      "symbol": {
        "type": "String",
        "example": "🐶"
      }
    }
  },
  "memoryCardClosedSemantics": "Closed card",
  "@memoryCardClosedSemantics": {
    "description": "Screen-reader label (not visible) for a face-down card."
  },

  "victoryTitle": "You did it!",
  "@victoryTitle": {
    "description": "Big title of the celebration dialog after winning. Children see it; joyful, max ~20 characters."
  },
  "victoryMessage": "You found all the pairs.",
  "@victoryMessage": {
    "description": "Line under the celebration title."
  },
  "victoryMovesSummary": "{count, plural, =1{Completed in 1 move} other{Completed in {count} moves}}",
  "@victoryMovesSummary": {
    "description": "Summary in the celebration dialog with the number of attempts. Translate every plural form your language needs.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "5"
      }
    }
  },
  "victoryBackToMenu": "Back to menu",
  "@victoryBackToMenu": {
    "description": "Button in the celebration dialog that returns to the main menu. Max ~20 characters."
  }
}
